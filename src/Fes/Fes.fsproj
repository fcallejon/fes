<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <WarnOn>3390;$(WarnOn)</WarnOn>
        <RootNamespace>Fes</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core"/>
        <PackageReference Include="FSharp.SystemTextJson"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Core library files (before generated code) -->
        <Compile Include="Prelude.fs"/>
        <Compile Include="Task.fs"/>
        <Compile Include="Result.fs"/>
        <Compile Include="TaskResult.fs"/>
        <Compile Include="Exceptions.fs"/>
        <!-- Generated types -->
        <Compile Include="Generated/Types/AllTypes.g.fs"/>
        <!-- Generated converters -->
        <Compile Include="Generated/Converters.g.fs"/>
        <!-- Core library files (after types/converters) -->
        <Compile Include="Json.fs"/>
        <Compile Include="Http.fs"/>
        <!-- Generated builders -->
        <!-- Generated operations -->
        <Compile Include="Generated/Operations/AsyncSearch.g.fs"/>
        <Compile Include="Generated/Operations/Autoscaling.g.fs"/>
        <Compile Include="Generated/Operations/Cat.g.fs"/>
        <Compile Include="Generated/Operations/Ccr.g.fs"/>
        <Compile Include="Generated/Operations/Cluster.g.fs"/>
        <Compile Include="Generated/Operations/Connector.g.fs"/>
        <Compile Include="Generated/Operations/DanglingIndices.g.fs"/>
        <Compile Include="Generated/Operations/Enrich.g.fs"/>
        <Compile Include="Generated/Operations/Eql.g.fs"/>
        <Compile Include="Generated/Operations/Esql.g.fs"/>
        <Compile Include="Generated/Operations/Features.g.fs"/>
        <Compile Include="Generated/Operations/Fleet.g.fs"/>
        <Compile Include="Generated/Operations/Global.g.fs"/>
        <Compile Include="Generated/Operations/Graph.g.fs"/>
        <Compile Include="Generated/Operations/Ilm.g.fs"/>
        <Compile Include="Generated/Operations/Indices.g.fs"/>
        <Compile Include="Generated/Operations/Inference.g.fs"/>
        <Compile Include="Generated/Operations/Ingest.g.fs"/>
        <Compile Include="Generated/Operations/License.g.fs"/>
        <Compile Include="Generated/Operations/Logstash.g.fs"/>
        <Compile Include="Generated/Operations/Migration.g.fs"/>
        <Compile Include="Generated/Operations/Ml.g.fs"/>
        <Compile Include="Generated/Operations/Monitoring.g.fs"/>
        <Compile Include="Generated/Operations/Nodes.g.fs"/>
        <Compile Include="Generated/Operations/Profiling.g.fs"/>
        <Compile Include="Generated/Operations/Project.g.fs"/>
        <Compile Include="Generated/Operations/QueryRules.g.fs"/>
        <Compile Include="Generated/Operations/Rollup.g.fs"/>
        <Compile Include="Generated/Operations/SearchApplication.g.fs"/>
        <Compile Include="Generated/Operations/SearchableSnapshots.g.fs"/>
        <Compile Include="Generated/Operations/Security.g.fs"/>
        <Compile Include="Generated/Operations/Shutdown.g.fs"/>
        <Compile Include="Generated/Operations/Simulate.g.fs"/>
        <Compile Include="Generated/Operations/Slm.g.fs"/>
        <Compile Include="Generated/Operations/Snapshot.g.fs"/>
        <Compile Include="Generated/Operations/Sql.g.fs"/>
        <Compile Include="Generated/Operations/Ssl.g.fs"/>
        <Compile Include="Generated/Operations/Streams.g.fs"/>
        <Compile Include="Generated/Operations/Synonyms.g.fs"/>
        <Compile Include="Generated/Operations/Tasks.g.fs"/>
        <Compile Include="Generated/Operations/TextStructure.g.fs"/>
        <Compile Include="Generated/Operations/Transform.g.fs"/>
        <Compile Include="Generated/Operations/Watcher.g.fs"/>
        <Compile Include="Generated/Operations/Xpack.g.fs"/>
        <Compile Include="Generated/Operations/ES.g.fs"/>
    </ItemGroup>
</Project>
