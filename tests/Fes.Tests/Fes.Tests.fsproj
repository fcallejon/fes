<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FsUnit.xUnit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test infrastructure -->
    <Compile Include="TestTransport.fs" />
    <Compile Include="Snapshot.fs" />
    <!-- Hand-written tests -->
    <Compile Include="SerializerTests.fs" />
    <Compile Include="TransportTests.fs" />
    <Compile Include="EndpointTests.fs" />
    <Compile Include="QueryBuilderTests.fs" />
    <Compile Include="AggregationBuilderTests.fs" />
    <Compile Include="JsonConverterTests.fs" />
    <Compile Include="PipelineTests.fs" />
    <!-- Generated tests -->
    <Compile Include="Generated/EndpointTests.g.fs" />
    <Compile Include="Generated/EnumRoundTripTests.g.fs" />
    <Compile Include="Generated/VariantTests.g.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fes\Fes.fsproj" />
  </ItemGroup>
</Project>
